{
  "name": "rumur/wp-jwt",
  "description": "WordPress JSON Web Token Authentication tool",
  "keywords": ["wordpress", "jwt", "JSON Web Token", "Auth"],
  "homepage": "https://github.com/rumur/wp-jwt",
  "license": "MIT",
  "authors": [
    {
      "name": "rumur",
      "email": "rumur.dev@gmail.com"
    }
  ],
  "autoload" : {
    "psr-4" : {
      "Rumur\\WordPress\\JsonWebToken\\": "src/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "extra": {
    "wordpress-install-dir": "tools/wp",
    "acorn": {
      "aliases": {
        "JWT": "Rumur\\WordPress\\JsonWebToken\\Facades\\JWT"
      },
      "providers": [
        "Rumur\\WordPress\\JsonWebToken\\JWTServiceProvider"
      ]
    },
    "laravel": {
      "aliases": {
        "JWT": "Rumur\\WordPress\\JsonWebToken\\Facades\\JWT"
      },
      "providers": [
        "Rumur\\WordPress\\JsonWebToken\\JWTServiceProvider"
      ]
    }
  },
  "require": {
    "php": ">=7.4.0|>=8.0.0",
    "ext-json": "*",
    "firebase/php-jwt": "^6.10"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "~3.1.0",
    "wp-phpunit/wp-phpunit": "^6.6",
    "roots/wordpress-no-content": "^6.6",
    "rector/rector": "^1.2",
    "roots/wordpress-core-installer": "^1.100",
    "phpunit/phpunit": "^9.6",
    "yoast/phpunit-polyfills": "^3.0"
  },
  "scripts": {
    "test": "./vendor/bin/phpunit",
    "lint": "./vendor/bin/phpcs -v",
    "lint:fix": "./vendor/bin/phpcbf -v",
    "rector": "./vendor/bin/rector process src --dry-run",
    "rector:fix": "./vendor/bin/rector process src"
  },
  "config": {
    "allow-plugins": {
      "roots/wordpress-core-installer": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
