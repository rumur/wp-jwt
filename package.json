{
	"name": "wp-jwt",
	"private": true,
	"version": "1.0.3",
	"description": "WordPress JSON Web Token Authentication tool.",
	"author": "rumur",
	"license": "MIT",
	"keywords": [
		"WordPress"
	],
	"engines": {
		"node": ">=20.0.0"
	},
	"homepage": "https://github.com/rumur/wp-jwt",
	"scripts": {
		"env": "wp-env",
		"start": "wp-env start",
		"stop": "wp-env stop",
		"stop-all": "docker stop $(docker ps -a -q)",
		"composer": "wp-env run wordpress --env-cwd=wp-content/plugins/wp-jwt -- composer",
		"wp": "wp-env run cli",
		"lint": "npm run composer -- lint",
		"lint:fix": "npm run composer -- lint:fix",
		"rector": "npm run composer -- rector",
		"rector:fix": "npm run composer -- rector:fix",
		"test": "wp-env run tests-wordpress --env-cwd=wp-content/plugins/wp-jwt -- composer test",
		"prepare": "git config core.hooksPath ./tools/git-hooks",
		"preinstall": "composer install"
	},
	"devDependencies": {
		"@wordpress/env": "^10.11.0",
		"lint-staged": "^15.2.10"
	},
  "lint-staged": {
    "*.php": "node tools/full-to-relative-path.js | xargs -I {} npm run lint {}"
  }
}
